# BAREA Environment Configuration Example

# SQLite Database Location (defaults to ./barea.db if unset)
BAREA_DB_PATH=./barea.db

# Google OAuth/OIDC Credentials (Required for Google Sign-In)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# For standard HTTP development: http://localhost:3000/api/auth/callback/google
# For HTTPS development: https://localhost:3000/api/auth/callback/google
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google

# Gemini AI Provider Key (for AI Question Generation)
GEMINI_API_KEY=

# Local Development Only Overrides (MUST be empty or unset in production)
# BAREA_DEV_ORG_ID=church-berea-default
# BAREA_DEV_USER_ID=teacher-dev-001
# BAREA_DEV_USER_NAME=Lead Sunday School Teacher
# Optional: explicitly set local/LAN development origin for mobile device testing (e.g. https://192.168.1.7:3000)
# BAREA_DEV_APP_URL=https://192.168.1.7:3000
# NEXT_PUBLIC_APP_URL=https://192.168.1.7:3000
